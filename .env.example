DATABASE_URL=postgresql+psycopg://rag:rag@127.0.0.1:5435/rag
LLM_BASE_URL=https://token.sensenova.cn/v1
LLM_API_KEY=sk-你的Key
LLM_MODEL=sensenova-6.8-flash-lite
# 在 https://tavily.com 注册获取（免费 1000 次/月）
TAVILY_API_KEY=tvly-你的Key

# 本地前后端请使用相同 hostname（例如均为 localhost）
APP_ENV=development
TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000
SESSION_HOURS=12
LOGIN_MAX_FAILURES=5
LOGIN_WINDOW_SECONDS=900
JOB_LEASE_SECONDS=120
JOB_MAX_ATTEMPTS=3
JOB_POLL_SECONDS=2
# 部署配置需要填写强密码及 URL 编码后的同一密码；不要照搬本地 rag:rag
POSTGRES_PASSWORD=
DEPLOY_DATABASE_URL=
