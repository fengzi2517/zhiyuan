DATABASE_URL=postgresql+psycopg://rag:rag@127.0.0.1:5435/rag
LLM_BASE_URL=https://token.sensenova.cn/v1
LLM_API_KEY=sk-你的Key
LLM_MODEL=sensenova-6.8-flash-lite
# 当前 SenseNova 默认关闭推理以降低交互延迟；其他供应商按其文档配置或留空
LLM_REASONING_EFFORT=none
LLM_MAX_TOKENS=4096
LLM_MAX_RETRIES=0
LLM_TIMEOUT_SECONDS=60
# 可选：服务端模型能力注册表。前端只发送 id，密钥和地址不下发。
# SenseNova 6.8 默认提供视觉和思考开关；深度模式省略 reasoning_effort 使用供应商默认思考。
# 其他模型必须显式配置 deep_options 才开放开关；具体参数以供应商支持为准。
# context_chars 是应用文本预算，max_images 是每轮原生图片上限。
# CHAT_MODEL_PROFILES=[{"id":"default","name":"SenseNova","model":"sensenova-6.8-flash-lite","vision":true,"fast_options":{"reasoning_effort":"none"},"deep_options":{},"context_chars":24000,"max_images":5}]
# 多供应商可增加 base_url 和 api_key_env（环境变量名，不填写密钥本身）。
# CPU 入库采用小批量，降低 PDF 多切块时峰值内存
EMBEDDING_BATCH_SIZE=4
# 在 https://tavily.com 注册获取（免费 1000 次/月）
TAVILY_API_KEY=tvly-你的Key

# 本地前后端请使用相同 hostname（例如均为 localhost）
APP_ENV=development
TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000
SESSION_HOURS=12
LOGIN_MAX_FAILURES=5
LOGIN_WINDOW_SECONDS=900
JOB_LEASE_SECONDS=120
JOB_MAX_ATTEMPTS=3
JOB_POLL_SECONDS=2
# 部署配置需要填写强密码及 URL 编码后的同一密码；不要照搬本地 rag:rag
POSTGRES_PASSWORD=
DEPLOY_DATABASE_URL=
